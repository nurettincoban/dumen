#!/bin/sh
# dumen-launch runs the dumen binary for the Claude Code plugin. It uses, in order:
# a dumen on PATH (for people who installed it themselves), the copy this plugin
# downloaded earlier, or, when started as the MCP server, a fresh download of the latest
# release, checked against the release's checksums. A hook never downloads: it fails open
# and the MCP server, which Claude Code starts with the session, fetches the binary.
set -u
repo="${DUMEN_RELEASE_URL:-https://github.com/nurettincoban/dumen/releases/latest/download}"
dir="${CLAUDE_PLUGIN_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/dumen-plugin}"

if command -v dumen >/dev/null 2>&1; then
  exec dumen "$@"
fi

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$os" in
  linux|darwin) ext="" ;;
  mingw*|msys*|cygwin*) os=windows; ext=".exe" ;;
  *) echo "dumen: no prebuilt binary for $os; install it with: go install github.com/nurettincoban/dumen/cmd/dumen@latest" >&2; exit 0 ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) echo "dumen: no prebuilt binary for $(uname -m)" >&2; exit 0 ;;
esac
bin="$dir/dumen$ext"

if [ ! -x "$bin" ]; then
  if [ "${1:-}" != "mcp" ]; then
    exit 0 # a hook: fail open, the MCP server installs the binary
  fi
  name="dumen_${os}_${arch}${ext}"
  mkdir -p "$dir" || exit 1
  tmp="$dir/.download.$$"
  fetch() {
    if command -v curl >/dev/null 2>&1; then curl -fsSL -o "$2" "$1"; else wget -q -O "$2" "$1"; fi
  }
  if ! fetch "$repo/$name" "$tmp" || ! fetch "$repo/checksums.txt" "$tmp.sums"; then
    rm -f "$tmp" "$tmp.sums"
    echo "dumen: could not download $name from the latest release" >&2
    exit 1
  fi
  want=$(grep " $name\$" "$tmp.sums" | cut -d' ' -f1)
  if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum "$tmp" | cut -d' ' -f1); else got=$(shasum -a 256 "$tmp" | cut -d' ' -f1); fi
  rm -f "$tmp.sums"
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    rm -f "$tmp"
    echo "dumen: checksum mismatch for $name; not installed" >&2
    exit 1
  fi
  chmod +x "$tmp" && mv "$tmp" "$bin" || exit 1
fi
exec "$bin" "$@"
